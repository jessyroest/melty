// Shareable single-host deploy: the relay Worker also serves the built web app
// (web/dist-share) as Workers static assets, so app + relay live on one
// https://melty.<subdomain>.workers.dev origin. Used by `pnpm deploy:share`
// (scripts/deploy-share.mjs), which also fills in ALLOWED_ORIGINS below.
// Local development keeps using wrangler.jsonc; this file changes nothing there.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "melty",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // no Workers Logs / traces: the relay must not produce logs at all
  "observability": { "enabled": false },
  "workers_dev": true,
  // no extra per-version hostnames whose origin would not be in ALLOWED_ORIGINS
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist-share",
    // /, /r and /how all get index.html; security headers come from dist-share/_headers
    "not_found_handling": "single-page-application",
    // WebSocket upgrades must reach the relay code, never the asset server
    "run_worker_first": ["/ws"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "LIMITER", "class_name": "Limiter" },
      { "name": "DOOR", "class_name": "Door" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Limiter"] },
    { "tag": "v2", "new_sqlite_classes": ["Door"] }
  ],
  "vars": {
    // the deployed origin; rewritten by scripts/deploy-share.mjs
    "ALLOWED_ORIGINS": "https://melty.granite-diadem.workers.dev"
  }
}
